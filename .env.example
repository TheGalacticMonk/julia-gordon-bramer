# Local development runs against a local D1 database (SQLite under .wrangler/state) and a
# local R2 bucket, both provided by wrangler from wrangler.jsonc — no database URL needed.

# Used to encrypt JWT tokens — generate with `openssl rand -hex 32`
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Outbound email for contact-form notifications, sent through Resend (https://resend.com).
# Leave RESEND_API_KEY unset in local dev — Payload logs emails to the console instead.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@juliagordonbramer.com
EMAIL_FROM_NAME="Julia Gordon-Bramer"
CONTACT_NOTIFY_TO=julia@juliagordonbramer.com

# Only needed for `pnpm deploy:database` / `pnpm preview` / local production builds, which talk
# to the real Cloudflare account (in CI / Workers Builds these are provided automatically).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
